# =============================================================================
#  CVM Monitor PRO -- variaveis de ambiente
#  Copie para .env e ajuste. Nenhuma e obrigatoria hoje: o projeto funciona
#  sem .env, baixando os dados da CVM direto. As de banco ficam prontas para
#  quando a persistencia migrar para MySQL.
# =============================================================================

# Porta do servidor quando executado direto (`python backend/main.py`).
PORT=8080

# Presente = modo producao: /docs, /redoc e /openapi.json ficam desligados.
# Deixe vazio em desenvolvimento.
RENDER=

# =============================================================================
# --- MySQL local (docker) ---
# =============================================================================
# O banco sobe em ../infra/docker-compose.yml e e compartilhado com o projeto
# Captacao-Resgate, cada um no seu schema.
#
# ATENCAO ao host:
#   mysql       -> de DENTRO de um container (nome do servico na rede bgc-net)
#   127.0.0.1   -> da sua maquina, rodando o app fora do Docker
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=cvm_monitor
DB_USER=cvm_app
DB_PASSWORD=cvm_dev_2026

# String de conexao pronta (SQLAlchemy + PyMySQL). Para usar, acrescente
# `SQLAlchemy>=2.0` e `PyMySQL>=1.1` ao backend/requirements.txt.
DATABASE_URL=mysql+pymysql://cvm_app:cvm_dev_2026@127.0.0.1:3307/cvm_monitor?charset=utf8mb4

# Dentro do container (o docker-compose.yml ja injeta este valor):
# DATABASE_URL=mysql+pymysql://cvm_app:cvm_dev_2026@mysql:3306/cvm_monitor?charset=utf8mb4
